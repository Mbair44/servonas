{
  "expo": {
    "name": "Servonas",
    "slug": "servonas",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "servonas",
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "Allow Servonas to attach a customer message photo.",
        "cameraPermission": "Allow Servonas to take a customer message photo."
      }],
      ["expo-notifications", {"color":"#2563EB"}]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.servonas.mobile"
    }
  }
}
