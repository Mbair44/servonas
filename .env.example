NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://epmnvizlyhftbqoomiql.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_SUPABASE_PUBLISHABLE_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Signing secret for the Stripe Connect webhook endpoint (connected-account events).
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Receives an email whenever a new business workspace is created.
ADMIN_EMAIL=

# Vercel custom-domain and registrar management. The token must have access to
# the Servonas project/team and Domains Registrar operations.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Highest first-year registrar cost covered by the standard-domain pilot offer.
VERCEL_STANDARD_DOMAIN_MAX_USD=25

# Customer messaging
# Keep this set to stub until you are ready to pay for an SMS provider.
SMS_DELIVERY_MODE=stub

# Only required later when SMS_DELIVERY_MODE=live
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
# Approved Servonas Primary Customer Profile. Phase 3 remains blocked until Twilio approves it.
TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=
# Optional area-code override/fallback source. Business phone and a future
# reliable address/ZIP provider take priority. Do not maintain a national map here.
# Example for a limited operating market: {"AZ:GILBERT":["480","602","623"]}
TWILIO_AREA_CODE_MARKET_FALLBACKS=
# Exact public webhook URLs used when validating Twilio signatures.
TWILIO_INBOUND_WEBHOOK_URL=https://your-domain.com/api/twilio/inbound
TWILIO_MISSED_CALL_WEBHOOK_URL=https://your-domain.com/api/twilio/missed-call
TWILIO_TENANT_MESSAGE_STATUS_WEBHOOK_URL=https://your-domain.com/api/twilio/tenant-message-status

# Optional AI qualification for Missed Call Recovery. Without this key,
# the conversation uses the safe deterministic intake fallback.
OPENAI_API_KEY=
OPENAI_MISSED_CALL_MODEL=gpt-4.1-mini
# Optional model for the in-app Servonas Assistant. Uses OPENAI_API_KEY above.
OPENAI_ASSISTANT_MODEL=gpt-4.1-mini

# Customer booking email delivery. Use a verified sender/domain in Resend.
EMAIL_DELIVERY_MODE=stub
RESEND_API_KEY=
EMAIL_FROM="Servonas <noreply@servonas.com>"
GOOGLE_REVIEW_URL=https://g.page/r/your-google-review-link/review
# Server-side key with Places API (New) enabled, used for live website ratings.
GOOGLE_MAPS_API_KEY=
# OAuth client approved for Google Business Profile APIs. The callback URL is
# https://your-domain.com/api/google-business/callback
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
CRON_SECRET=choose-a-long-random-secret
# Salt for hashing public-portal request fingerprints. Use a separate random value.
PUBLIC_LINK_RATE_LIMIT_SECRET=choose-another-long-random-secret
# Optional dedicated HMAC secret for correlating public visitors without logging raw IPs.
# Falls back to PUBLIC_LINK_RATE_LIMIT_SECRET when omitted.
VISITOR_LOG_HASH_SECRET=choose-a-third-long-random-secret
